[Unit]
Description=Private knowledge review dashboard on loopback for Tailscale Serve
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/you/development/knowledge-vault
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/bash -c 'source /home/you/.claude-shared/telegram.env && exec /usr/bin/python3 -m reviewer --config /home/you/development/knowledge-vault/ops/reviewer.json dashboard'
Restart=on-failure
RestartSec=5
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=true
ReadWritePaths=/home/you/development/knowledge-vault/.state /home/you/development/knowledge-vault/vault

[Install]
WantedBy=default.target
